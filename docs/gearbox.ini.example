; Example gearbox.ini - annotated. gearbox-setup.exe writes this file for you; you do not
; normally hand-edit it. Kept here so the format is documented alongside the source.
;
; Offsets below are the GOG release v1.3 (English) values - the only tested build. See
; docs/HOW-IT-WORKS.md and the README's "For developers" table.

[hook]
; One device per lever/wheelbase. "device1" is the DirectInput product name
; gearbox-setup.exe found when you clicked Capture; copy it exactly as shown there.
device1=YOUR-SHIFTER-DEVICE-NAME
; Buttons on that device that must be suppressed from the game (zeroed out of its own
; device state) because they are bound to gears here, not to whatever the game's
; control-binding screen has them mapped to. Comma-separated button indices.
suppress1=0,1,2,3,4,5,6,7

[shift]
enable=1
; 0 = open loop: keys are injected but the gear is not read back or clamped. Use this on
; the first run against an unverified build, and check the log for the chain-ok record
; before switching to 1.
closed_loop=1

; Each gearN/reverse maps a target gear to "<device index>:<button index>".
gear1=1:0
gear2=1:1
gear3=1:2
gear4=1:3
gear5=1:4
gear6=1:5
reverse=1:6
; -1 means neutral is the lever's own rest position (no dedicated button). Any other
; "device:button" pair means a dedicated neutral button.
neutral=-1
; Optional: a second device's button that switches manual/automatic. Omit if you only
; ever switch mode from inside the game.
mode_btn=1:7

; DIK scancodes of the keys bound to gear-up, gear-down and mode IN MAFIA'S OWN CONTROL
; OPTIONS. The mod shifts by pressing these keys, so they must match your in-game
; bindings exactly, or nothing will happen. gearbox-setup.exe captures these for you.
gearup_dik=0x1E
geardown_dik=0x2C
mode_dik=0x30

hold_ms=40
gap_ms=60
retry_ms=1200
neutral_delay_ms=1100
; 1 if the mode control is a latching switch (position is the truth, acts on
; transitions); 0 if it is a momentary button.
mode_hold=0

; ---- address table (GOG release v1.3, English) ----------------------------------------
; Do not edit unless you know what you are doing - these are the confirmed GOG offsets
; from docs/HOW-IT-WORKS.md. A different build (Steam, other language, other version) is
; untested and these will not resolve; the mod disables the shifter rather than write a
; blind offset on a build it does not recognise.
gear_ofs=0x5D0
mode_ofs=0x53C

[app]
; Absolute path to Game.exe. gearbox-setup.exe finds this automatically (it looks one
; folder up from where it runs); only set this by hand if you copied the tool elsewhere.
game_exe=C:\path\to\your\Mafia\Game.exe
