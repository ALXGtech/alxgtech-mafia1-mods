/* ALXGtech Mafia 1 Mods.exe's resources: the same payload the console patcher embeds, plus this
   exe's own manifest. Paths are relative to the project root, which is where
   tools\build-launcher.ps1 invokes windres from. */

/* An #include in a .rc resolves relative to THIS file, while the RCDATA paths inside it resolve
   relative to the working directory windres was invoked from - the project root. The two are
   not the same rule, which is worth knowing before "fixing" either path. */
#include "../patcher/payload_data.rc"

1 24 "src/launcher/launcher.manifest"

/* The icons. All four are GENERATED by tools\make-icons.py - change the drawing there, re-run,
   rebuild. Ids must match IDI_* in src/launcher/mod_state.h.

   10 IS DELIBERATELY THE LOWEST ICON ID. Explorer, the taskbar and the alt-tab list all show the
   resource with the numerically smallest id, so a tab icon numbered below the application's would
   quietly become the program's face. */
10  ICON "src/spike/app.ico"
200 ICON "src/spike/gearbox.ico"
201 ICON "src/spike/ffb.ico"
202 ICON "src/spike/fpv.ico"
203 ICON "src/spike/vr.ico"
